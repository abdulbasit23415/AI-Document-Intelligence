FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    libgl1 \
    libglib2.0-0 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    fastapi uvicorn sqlalchemy psycopg2-binary pydantic pydantic-settings \
    pyjwt bcrypt python-multipart fitz pymupdf pypdf python-docx pillow pytesseract \
    sentence-transformers torch torchvision accelerate redis celery psutil httpx

COPY . /app

CMD ["celery", "-A", "apps.worker.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
